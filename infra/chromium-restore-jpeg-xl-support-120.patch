+    -Wfloat-zero-conversion
+    -Wfor-loop-analysis
+    -Wgnu-redeclared-enum
+    -Winfinite-recursion
+    -Wliteral-conversion
+    -Wno-c++98-compat
+    -Wno-unused-command-line-argument
+    -Wprivate-header
+    -Wself-assign
+    -Wstring-conversion
+    -Wtautological-overlap-compare
+    -Wthread-safety-analysis
+    -Wundefined-func-template

+void TestSize(const char* jxl_file, gfx::Size expected_size) {
+  auto decoder = CreateJXLDecoderWithData(jxl_file);
+  EXPECT_TRUE(decoder->IsSizeAvailable());
+  EXPECT_EQ(expected_size, decoder->Size());
+}

+#endif  // LIB_JXL_RENDER_PIPELINE_RENDER_PIPELINE_H_
diff -up chromium-116.0.5845.96/third_party/libjxl/src/lib/jxl/render_pipeline/render_pipeline_stage.h.15~ chromium-116.0.5845.96/third_party/libjxl/src/lib/jxl/render_pipeline/render_pipeline_stage.h

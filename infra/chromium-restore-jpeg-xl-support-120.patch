+    -Wunused-comparison
+  )
+  if (CMAKE_CXX_COMPILER_VERSION VERSION_GREATER 5.0)
+    list(APPEND HWY_FLAGS -Wc++2a-extensions)
+  endif()
+endif()  # Clang
+
+if (WIN32)
+  list(APPEND JPEGXL_INTERNAL_FLAGS
+    -Wno-cast-align
+    -Wno-double-promotion
+    -Wno-float-equal
+    -Wno-format-nonliteral
+    -Wno-shadow
+    -Wno-sign-conversion
+    -Wno-zero-as-null-pointer-constant

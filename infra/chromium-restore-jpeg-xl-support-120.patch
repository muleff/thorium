+# license that can be found in the LICENSE file.
+
+find_package(Qt5 QUIET COMPONENTS Widgets)
+if (NOT Qt5_FOUND)
+  message(WARNING "Qt5 was not found. The directory viewer will not be built.")
+  return()
+endif ()
+
+if (NOT TARGET icc_detect)
+  message(WARNING "The directory viewer depends on the comparison tool and will also not be built.")
+  return ()
+endif ()
+
+set(CMAKE_INCLUDE_CURRENT_DIR ON)
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTOUIC ON)
+
+add_executable(viewer WIN32
+  load_jxl.cc
+  load_jxl.h
+  main.cc
+  viewer_window.cc
+  viewer_window.h
+  viewer_window.ui
+)
+target_include_directories(viewer PRIVATE
+  $<TARGET_PROPERTY:lcms2,INCLUDE_DIRECTORIES>
+  "${PROJECT_SOURCE_DIR}"
+)
+target_link_libraries(viewer
+  Qt5::Widgets
+  icc_detect
+  jxl
+  jxl_threads
+  lcms2
+)
diff -up chromium-116.0.5845.96/third_party/libjxl/src/tools/viewer/load_jxl.cc.15~ chromium-116.0.5845.96/third_party/libjxl/src/tools/viewer/load_jxl.cc
